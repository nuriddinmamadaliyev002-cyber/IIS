# ─── Server ───
PORT=3001

# ─── PostgreSQL ───
DB_HOST=localhost
DB_PORT=5432
DB_NAME=innovateit
DB_USER=innovateit_user
DB_PASSWORD=STRONG_PASSWORD_HERE

# ─── Super Admin ───
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PAROL=00000000
SUPER_ADMIN_ISM=InnovateIT School Manager

# ─── JWT ───
JWT_SECRET=kamida_32_belgi_uzunlikda_maxfiy_kalit
JWT_EXPIRES=8h

# ─── Chat fayllari (ixtiyoriy; berilmasa standart qiymatlar) ───
# CHAT_MAX_MB=95        # bitta fayl/audio limiti (Cloudflare bepul tarifi 100MB)
# CHAT_KVOTA_MB=500     # bitta foydalanuvchi uchun 24 soatlik yuklash kvotasi

# ─── Telegram Mini App imzosini tekshirish (online kurslar uchun MAJBURIY) ───
# telegram-bot/.env dagi TELEGRAM_BOT_TOKEN bilan bir xil bo'lsin. Bo'lmasa kurs
# admini/ishtirokchisi kira olmaydi (server 501 qaytaradi).
TELEGRAM_BOT_TOKEN=123456:BOT_TOKEN_HERE

# ─── Sertifikatdagi QR kod ko'rsatadigan sayt (oxirida / bo'lmasin) ───
CERT_VERIFY_BASE=https://innovateitschool.uz
